<!DOCTYPE html><html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>潘悦鑫·简历</title><style>:root{--p:#6366F1;--a:#F59E0B;--bg:linear-gradient(135deg,#E0E7FF,#DBEAFE,#EFF6FF);--bgc:#fff;--bgs:#F1F5F9;--t:#1E293B;--ts:#475569;--tm:#94A3B8;--b:#E2E8F0;--r:12px;--nav:56px;--prog:#1E293B}[data-theme="dark"]{--bg:linear-gradient(135deg,#1E1B4B,#172554,#0F172A);--bgc:#1E293B;--bgs:#1A2332;--t:#F1F5F9;--ts:#CBD5E1;--tm:#64748B;--b:#334155;--prog:#F1F5F9}@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:linear-gradient(135deg,#1E1B4B,#172554,#0F172A);--bgc:#1E293B;--bgs:#1A2332;--t:#F1F5F9;--ts:#CBD5E1;--tm:#64748B;--b:#334155;--prog:#F1F5F9}}*{box-sizing:border-box;margin:0;padding:0}html{scroll-behavior:smooth;scroll-padding-top:calc(var(--nav) + 16px)}body{font-family:'PingFang SC','Microsoft YaHei',system-ui,sans-serif;background:var(--bg);background-size:400% 400%;animation:grad 15s ease infinite;color:var(--t);line-height:1.6;-webkit-font-smoothing:antialiased}@keyframes grad{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}.nav{position:fixed;top:0;left:0;right:0;z-index:10;height:var(--nav);background:var(--bgc);border-bottom:1px solid var(--b);display:flex;align-items:center;justify-content:space-between;padding:0 12px;backdrop-filter:blur(12px)}.nav-brand{font-weight:700;color:var(--p)}.nav-links a{color:var(--ts);text-decoration:none;font-size:.8rem;padding:8px 10px;border-radius:8px;min-height:44px;display:inline-flex;align-items:center}.nav-links a:hover{color:var(--p);background:var(--bgs)}.icon-btn{width:44px;height:44px;border-radius:50%;border:1px solid var(--b);background:var(--bgc);cursor:pointer;font-size:1.1rem;display:flex;align-items:center;justify-content:center;color:var(--ts)}.main{max-width:600px;margin:0 auto;padding:calc(var(--nav) + 24px) 16px 40px}.hero{text-align:center;padding:32px 8px 28px}.avatar{width:90px;height:90px;border-radius:50%;background:linear-gradient(135deg,var(--p),#8B5CF6);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;font-size:2rem;color:#fff;font-weight:700;overflow:hidden;box-shadow:0 8px 20px rgba(0,0,0,.1)}.avatar img{width:100%;height:100%;object-fit:cover}.hero h1{font-size:1.9rem;font-weight:800}.subtitle{font-size:.9rem;color:var(--ts)}.motto{font-style:italic;color:var(--p);margin-bottom:14px}.badges{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;margin-bottom:18px}.badge{display:inline-block;padding:5px 12px;border-radius:20px;font-size:.78rem;font-weight:500}.badge-pri{background:var(--p);color:#fff}.badge-out{background:transparent;border:1.5px solid var(--p);color:var(--p)}.badge-acc{background:var(--a);color:#1E293B;font-weight:600}.badge-soft{background:var(--bgs);color:var(--ts);border:1px solid var(--b)}.btn{display:inline-flex;align-items:center;gap:5px;padding:10px 18px;border-radius:25px;font-size:.85rem;font-weight:600;cursor:pointer;border:none;text-decoration:none;min-height:44px;background:var(--bgs);color:var(--t);border:1px solid var(--b)}.btn-pri{background:var(--p);color:#fff}.btn-out{background:transparent;border:2px solid var(--p);color:var(--p)}.section{margin:28px 0}.section-title{font-size:1.3rem;font-weight:700;margin-bottom:16px;display:flex;align-items:center;gap:8px}.section-title::before{content:'';display:inline-block;width:4px;height:20px;background:var(--p);border-radius:2px}.highlights{display:grid;grid-template-columns:1fr 1fr;gap:8px}.hl-card{background:var(--bgc);border:1px solid var(--b);border-radius:var(--r);padding:16px 10px;text-align:center}.hl-icon{font-size:1.4rem}.hl-num{font-size:1.4rem;font-weight:800;color:var(--p)}.hl-label{font-size:.78rem;color:var(--ts)}.tabs-nav{display:flex;gap:4px;border-bottom:2px solid var(--b);margin-bottom:16px}.tab-btn{padding:10px 16px;border:none;background:transparent;cursor:pointer;font-size:.88rem;font-weight:600;color:var(--tm);border-bottom:3px solid transparent;margin-bottom:-2px;min-height:44px;font-family:inherit}.tab-btn.active{color:var(--p);border-bottom-color:var(--p)}.tab-panel{display:none}.tab-panel.active{display:block;animation:fade .2s}@keyframes fade{from{opacity:0}to{opacity:1}}.exp-card{background:var(--bgc);border:1px solid var(--b);border-radius:var(--r);padding:16px;margin-bottom:12px;border-left:4px solid var(--p)}.exp-header{display:flex;justify-content:space-between;flex-wrap:wrap;gap:6px;margin-bottom:6px}.exp-title{font-weight:700;font-size:.95rem}.exp-org{font-weight:500;color:var(--p);font-size:.85rem}.exp-date{font-size:.75rem;color:var(--tm)}.exp-list{list-style:none;padding:0}.exp-list li{position:relative;padding-left:16px;margin-bottom:4px;font-size:.83rem;color:var(--ts)}.exp-list li::before{content:'▸';position:absolute;left:0;color:var(--p)}.skills-grid{display:grid;grid-template-columns:1fr;gap:10px}.skill-cat{background:var(--bgc);border:1px solid var(--b);border-radius:var(--r);padding:14px}.skill-cat h4{font-size:.9rem;margin-bottom:12px}.skill-item{margin-bottom:10px}.skill-row{display:flex;justify-content:space-between;font-size:.8rem;color:var(--ts);margin-bottom:4px}.skill-bar{height:6px;background:var(--bgs);border-radius:3px;overflow:hidden}.skill-fill{height:100%;border-radius:3px;background:var(--prog);width:0;transition:width .6s}.edu-grid{display:grid;grid-template-columns:1fr;gap:12px}.edu-card,.cert-card{background:var(--bgc);border:1px solid var(--b);border-radius:var(--r);padding:16px}.cert-list{list-style:none;padding:0}.cert-list li{font-size:.8rem;color:var(--ts);padding:5px 0;border-bottom:1px dotted var(--b)}.cert-img{margin-top:10px;text-align:center}.cert-img img{max-width:100%;height:auto;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,.1)}.footer{text-align:center;padding:20px;color:var(--tm);font-size:.75rem;border-top:1px solid var(--b)}.back-top{position:fixed;bottom:20px;right:20px;width:44px;height:44px;border-radius:50%;background:var(--p);color:#fff;border:none;cursor:pointer;font-size:1.2rem;z-index:9;opacity:0;pointer-events:none;display:flex;align-items:center;justify-content:center}.back-top.show{opacity:1;pointer-events:auto}.toast{position:fixed;top:70px;left:50%;transform:translateX(-50%);background:#1E293B;color:#fff;padding:8px 18px;border-radius:20px;font-size:.8rem;z-index:20;opacity:0;pointer-events:none;transition:opacity .3s}.toast.show{opacity:1}@media(min-width:640px){.main{max-width:900px}.highlights{grid-template-columns:repeat(5,1fr)}.skills-grid{grid-template-columns:repeat(3,1fr)}.edu-grid{grid-template-columns:1fr 1fr}}@media print{.nav,.back-top,.toast,.btn{display:none!important}body{background:#fff!important;animation:none}.main{padding:0 12px!important;max-width:100%!important}.tab-panel{display:block!important}.tabs-nav{display:none!important}}</style></head><body><nav class="nav"><span class="nav-brand">潘悦鑫</span><div class="nav-links"><a href="#hero">摘要</a><a href="#highlights">亮点</a><a href="#exp">经历</a><a href="#skills">技能</a><a href="#edu">教育</a></div><div class="nav-actions"><button class="icon-btn" id="themeToggle" aria-label="切换深色">🌓</button><button class="icon-btn" id="printBtn" aria-label="打印">🖨️</button></div></nav><div class="toast" id="toast"></div><main class="main"><section class="hero" id="hero"><div class="avatar"><img src="logo.jpg" alt="潘悦鑫头像" loading="lazy"></div><h1>潘悦鑫</h1><p class="subtitle">电子信息工程 2026届 · AI应用探索者</p><p class="motto">「生如逆旅，一苇以航」</p><div class="badges"><span class="badge badge-pri">🏅 7项AI认证</span><span class="badge badge-acc">ENTJ</span><span class="badge badge-out">绘画九级</span><span class="badge badge-soft">🎨5年绘画</span><span class="badge badge-soft">📚9年课代表</span></div><p style="max-width:600px;margin:0 auto 20px;color:var(--ts);font-size:.9rem">常州大学电子信息工程大一新生，毕业于光山二高。ENTJ型人格，自主规划力强。五年绘画经验（素描九级），连续九年担任英语课代表。热衷AI技术，持有7张AI认证，涵盖大模型开发、Prompt工程与AI训练，致力于将艺术审美与AI技术融合。</p><div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:center"><a class="btn btn-pri" href="tel:18237681998">📞 18237681998</a><button class="btn btn-out" onclick="copyEmail()">📧 复制邮箱</button><button class="btn" onclick="copyWechat()">💬 微信:pyx2616132</button></div></section><section class="section" id="highlights"><h2 class="section-title">亮点成果</h2><div class="highlights"><div class="hl-card"><div class="hl-icon">📜</div><div class="hl-num">7项</div><div class="hl-label">AI认证</div></div><div class="hl-card"><div class="hl-icon">🎨</div><div class="hl-num">5年</div><div class="hl-label">绘画经验</div></div><div class="hl-card"><div class="hl-icon">📊</div><div class="hl-num">5000+</div><div class="hl-label">数据标注</div></div><div class="hl-card"><div class="hl-icon">📈</div><div class="hl-num">92%</div><div class="hl-label">模型提升</div></div><div class="hl-card"><div class="hl-icon">🎬</div><div class="hl-num">5.3万</div><div class="hl-label">视频播放</div></div></div></section><section class="section" id="exp"><h2 class="section-title">经历</h2><div class="tabs-nav"><button class="tab-btn active" onclick="switchTab('exp','exp0')">实践经历</button><button class="tab-btn" onclick="switchTab('exp','exp1')">校园经历</button></div><div class="tab-panel active" id="exp0"><div class="exp-card"><div class="exp-header"><div><div class="exp-title">AI数据标注与模型评估实训</div><div class="exp-org">阿里云线上实训</div></div><span class="exp-date">2026.01–02</span></div><ul class="exp-list"><li>完成5000+张图像标注与质检，清洗10%噪声。</li><li>优化标注规则，模型mAP从85%升至92%。</li><li>报告获评优秀，向200+学员分享经验。</li></ul></div><div class="exp-card"><div class="exp-header"><div><div class="exp-title">大模型微调与部署实训</div><div class="exp-org">浪潮信息大模型开发实训</div></div><span class="exp-date">2026.05–06</span></div><ul class="exp-list"><li>完成大模型微调、Prompt优化及模型部署全流程。</li><li>搭建校园智能问答原型，测试准确率89%。</li><li>获浪潮信息大模型开发工程师认证。</li></ul></div><div class="exp-card"><div class="exp-header"><div><div class="exp-title">AI绘画与短视频创作</div><div class="exp-org">独立创作者</div></div><span class="exp-date">2026.04–至今</span></div><ul class="exp-list"><li>结合SD与手绘，完成30+作品，风格统一度提升40%。</li><li>《AI绘梦》系列视频播放5.3万，涨粉800+。</li><li>优化流程，单条视频制作耗时压缩58%。</li></ul></div></div><div class="tab-panel" id="exp1"><div class="exp-card"><div class="exp-header"><div><div class="exp-title">英语课代表</div><div class="exp-org">光山二高</div></div><span class="exp-date">2017.09–2026.06</span></div><ul class="exp-list"><li>连续九年课代表，班级英语均分年级前三。</li><li>组织英语角等活动，参与超200人次。</li><li>获全国英语竞赛一等奖，多次评为三好学生。</li></ul></div></div></section><section class="section" id="skills"><h2 class="section-title">技能矩阵</h2><div class="skills-grid"><div class="skill-cat"><h4>AI与大模型</h4><div class="skill-item"><div class="skill-row"><span>数据标注</span><span>90%</span></div><div class="skill-bar"><div class="skill-fill" style="width:90%"></div></div></div><div class="skill-item"><div class="skill-row"><span>模型微调</span><span>75%</span></div><div class="skill-bar"><div class="skill-fill" style="width:75%"></div></div></div><div class="skill-item"><div class="skill-row"><span>Prompt工程</span><span>85%</span></div><div class="skill-bar"><div class="skill-fill" style="width:85%"></div></div></div><div class="skill-item"><div class="skill-row"><span>大模型部署</span><span>70%</span></div><div class="skill-bar"><div class="skill-fill" style="width:70%"></div></div></div></div><div class="skill-cat"><h4>编程与工具</h4><div class="skill-item"><div class="skill-row"><span>Python</span><span>70%</span></div><div class="skill-bar"><div class="skill-fill" style="width:70%"></div></div></div><div class="skill-item"><div class="skill-row"><span>NumPy/Pandas</span><span>65%</span></div><div class="skill-bar"><div class="skill-fill" style="width:65%"></div></div></div><div class="skill-item"><div class="skill-row"><span>TensorFlow/PyTorch</span><span>50%</span></div><div class="skill-bar"><div class="skill-fill" style="width:50%"></div></div></div><div class="skill-item"><div class="skill-row"><span>CVAT/LabelImg</span><span>90%</span></div><div class="skill-bar"><div class="skill-fill" style="width:90%"></div></div></div></div><div class="skill-cat"><h4>绘画与设计</h4><div class="skill-item"><div class="skill-row"><span>素描(九级)</span><span>95%</span></div><div class="skill-bar"><div class="skill-fill" style="width:95%"></div></div></div><div class="skill-item"><div class="skill-row"><span>Procreate/PS</span><span>85%</span></div><div class="skill-bar"><div class="skill-fill" style="width:85%"></div></div></div><div class="skill-item"><div class="skill-row"><span>Stable Diffusion</span><span>75%</span></div><div class="skill-bar"><div class="skill-fill" style="width:75%"></div></div></div><div class="skill-item"><div class="skill-row"><span>视频剪辑</span><span>80%</span></div><div class="skill-bar"><div class="skill-fill" style="width:80%"></div></div></div></div></div></section><section class="section" id="edu"><h2 class="section-title">教育与证书</h2><div class="edu-grid"><div class="edu-card"><h4>🎓 教育背景</h4><p><strong>常州大学 (本科) | 光山二高</strong></p><p>电子信息工程 2026届</p><p>大学: 2026.09–2030.06 高中: 2023.09–2026.06</p><p style="font-size:.8rem;color:var(--tm)">主修: 高等数学、线性代数、C语言、电路分析、数字电子技术、信号与系统、人工智能导论</p></div><div class="cert-card"><h4>🏅 获奖与证书</h4><ul class="cert-list"><li>阿里云AI训练师（高级）认证</li><li>阿里云AI训练师（初级）认证</li><li>阿里云大模型 Clouder 认证 ×2</li><li>国际培训中心人工智能证书</li><li>浪潮信息大模型开发工程师认证</li><li>讯飞星火 Prompt 工程师认证</li><li>英语周报卡西欧杯一等奖</li><li>素描九级证书</li><li>连续九年三好学生/优秀班干部</li></ul><div class="cert-img"><img src="work_1.jpg" alt="英语竞赛证书" loading="lazy"></div></div></div></section></main><button class="back-top" id="backTop">↑</button><footer class="footer">© 2026 潘悦鑫 · 生如逆旅，一苇以航</footer><script>(function(){const email="pyx2616132"+"@"+"qq.com";const wechat="pyx2616132";const toast=document.getElementById("toast");function showToast(m){toast.textContent="✓ "+m;toast.classList.add("show");clearTimeout(toast._t);toast._t=setTimeout(()=>toast.classList.remove("show"),2000)}window.copyEmail=function(){copyText(email)};window.copyWechat=function(){copyText(wechat)};function copyText(t){if(navigator.clipboard)navigator.clipboard.writeText(t).then(()=>showToast("已复制"));else{const ta=document.createElement("textarea");ta.value=t;ta.style.position="fixed";ta.style.opacity="0";document.body.appendChild(ta);ta.select();document.execCommand("copy");document.body.removeChild(ta);showToast("已复制")}}window.switchTab=function(group,targetId){const section=document.getElementById(group);if(!section)return;section.querySelectorAll(".tab-btn").forEach(btn=>{btn.classList.toggle("active",btn.getAttribute("onclick").includes(targetId))});section.querySelectorAll(".tab-panel").forEach(panel=>{panel.classList.toggle("active",panel.id===targetId)})};const themeToggle=document.getElementById("themeToggle");function applyTheme(t){if(t==="dark"){document.documentElement.setAttribute("data-theme","dark");themeToggle.textContent="☀️"}else if(t==="light"){document.documentElement.setAttribute("data-theme","light");themeToggle.textContent="🌙"}else{document.documentElement.removeAttribute("data-theme");themeToggle.textContent="🌓"}}function cycleTheme(){const s=localStorage.getItem("theme");if(!s){const sys=matchMedia("(prefers-color-scheme:dark)").matches?"dark":"light";localStorage.setItem("theme",sys==="dark"?"light":"dark");applyTheme(sys==="dark"?"light":"dark")}else if(s==="dark"){localStorage.setItem("theme","light");applyTheme("light")}else{localStorage.removeItem("theme");applyTheme(null)}}const init=localStorage.getItem("theme");if(init)applyTheme(init);else applyTheme(null);themeToggle.addEventListener("click",cycleTheme);matchMedia("(prefers-color-scheme:dark)").addEventListener("change",()=>{if(!localStorage.getItem("theme"))applyTheme(null)});document.getElementById("printBtn").addEventListener("click",()=>window.print());const backTop=document.getElementById("backTop");window.addEventListener("scroll",()=>backTop.classList.toggle("show",scrollY>300),{passive:true});backTop.addEventListener("click",()=>scrollTo({top:0,behavior:"smooth"}))})();</script></body></html>
